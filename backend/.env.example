PORT=4000
# Local par défaut ; pour Atlas, utilisez une URI complète avec nom de base :
MONGODB_URI=mongodb://127.0.0.1:27017/stb_credit
# Exemple Atlas :
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/stb_credit?retryWrites=true&w=majority

JWT_SECRET=changez-moi-en-production-min-32-caracteres
JWT_EXPIRES_IN=7d
SCORING_SERVICE_URL=http://127.0.0.1:5001

# NLP assistant (Gemini) — optionnel ; sinon extraction regex locale
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

UPLOAD_DIR=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@stb.local

# URL du portail React (liens d'activation par email)
FRONTEND_URL=http://127.0.0.1:5173
